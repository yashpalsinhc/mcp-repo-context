# GitHub Personal Access Token (required for private repos)
GITHUB_TOKEN=ghp_your_token_here

# Anthropic API Key (required for AI features: ask, generate_ai_summary, etc.)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: Anthropic model (defaults to claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PostgreSQL password (if using with-postgres profile)
DB_PASSWORD=mcppassword
